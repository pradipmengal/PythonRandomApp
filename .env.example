# App
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (used to build DATABASE_URL if that is not set)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_APP_DB=randomdata
PG_APP_USER=randomdata
PG_APP_PASSWORD=randomdata

# App connects through PgBouncer (transaction pooling).
DATABASE_URL=postgresql://randomdata:randomdata@127.0.0.1:6432/randomdata
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
# Direct Postgres endpoint (used by init-db / admin tasks):
# DIRECT_DATABASE_URL=postgresql://randomdata:randomdata@127.0.0.1:5432/randomdata

# Tuning
# DB_POOL_MIN=1
# DB_POOL_MAX=8
# INSERT_BATCH_SIZE=250
# PROGRESS_PERSIST_SECONDS=2
